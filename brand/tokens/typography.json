{
  "_comment": "Font stacks the Tailwind preset maps to font-sans / font-display / font-mono. Each app wires the webfonts itself (next/font/google) and must expose the CSS variables named below. Documented in docs/design/typography.yml.",
  "fontFamily": {
    "sans": ["var(--font-inter)", "ui-sans-serif", "system-ui", "sans-serif"],
    "display": ["var(--font-space-grotesk)", "ui-sans-serif", "system-ui", "sans-serif"],
    "mono": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
  },
  "webfonts": {
    "inter": {
      "cssVariable": "--font-inter",
      "utility": "font-sans",
      "loader": "next/font/google"
    },
    "spaceGrotesk": {
      "cssVariable": "--font-space-grotesk",
      "utility": "font-display",
      "loader": "next/font/google"
    }
  }
}
